# 复制为 .env 并在启动前加载（或直接设置系统环境变量）
# Windows PowerShell 示例：
#   $env:APP_SECRET_KEY="换成随机长字符串"
#   $env:DEFAULT_TEACHER_PASSWORD="换成强密码"

APP_SECRET_KEY=change-me-please
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000

# 默认教师账号（首次启动自动创建）
DEFAULT_TEACHER_USERNAME=teacher
DEFAULT_TEACHER_PASSWORD=replace-with-a-strong-password
DEFAULT_TEACHER_NAME=管理员

# 学校与系统名称
SCHOOL_NAME=西南科技大学
SYSTEM_NAME=本科毕业论文检查系统

# 路径（留空则使用项目下默认目录）
DB_PATH=
UPLOAD_DIR=
REPORT_DIR=
LOG_DIR=

# 上传限制（MB）
MAX_UPLOAD_MB=30

# HTTPS 部署时启用；本地 HTTP 开发保持 false
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8

# 正式部署填写允许的域名，逗号分隔，例如 review.example.com
TRUSTED_HOSTS=
