# Anonymous display mode for screenshots, reports and videos.
COMPETITION_MODE=true
PUBLIC_ORGANIZATION_NAME=参赛作品
SYSTEM_NAME=文衡·多智能体论文质检平台

# Never keep real credentials in this file.
APP_SECRET_KEY=replace-with-a-long-random-value
DEFAULT_TEACHER_USERNAME=reviewer
DEFAULT_TEACHER_PASSWORD=replace-with-a-strong-password
DEFAULT_TEACHER_NAME=评审管理员
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_HOURS=8
TRUSTED_HOSTS=REPLACE_WITH_PUBLIC_HOST

# AIP/ACPs wiring.
# Production: enable identity binding and point Discovery at the platform.
AIP_IDENTITY_BINDING_ENABLED=false
AIP_ALLOW_LOCAL_PATHS=false
AIP_LEADER_ID=local-thesis-review-leader

# Unset means the Leader uses the explicit URLs below (local one-command demo).
# When set, the Leader resolves Partner endpoints through the discovery server.
AIP_DISCOVERY_BASE_URL=
AIP_DISCOVERY_TIMEOUT_S=10
AIP_DISCOVERY_LIMIT=5

AIP_FORMAT_URL=http://127.0.0.1:9021/rpc
AIP_LOGIC_URL=http://127.0.0.1:9022/rpc
AIP_CROSS_STAGE_URL=http://127.0.0.1:9023/rpc

AIP_FORMAT_QUERY=论文格式检查智能体
AIP_LOGIC_QUERY=论文逻辑审查智能体
AIP_CROSS_STAGE_QUERY=论文跨阶段对比智能体

AIP_TASK_TIMEOUT_S=120
AIP_POLL_INTERVAL_S=0.1
